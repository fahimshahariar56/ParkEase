# ParkEase Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=parkease_db
DB_CONNECTION_LIMIT=10

# Authentication & Security
# Required: configure a unique cryptographically random secret (at least 32 characters).
JWT_SECRET=
JWT_EXPIRES_IN=24h
